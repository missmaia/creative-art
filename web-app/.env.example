# 🍌 Viva La Selfie - Nano Banana Pro Edition!
# Copy this file to .env and add your actual API keys

# 🔑 Google Gemini API Key (for Nano Banana Pro brain power!)
# Get this from: https://aistudio.google.com/app/apikey
# This is used to analyze your selfie and understand your appearance
GOOGLE_API_KEY=your_google_api_key_here

# 🎨 Fal.ai API Key (for generating the celebrity photos!)
# Get this from: https://fal.ai/dashboard/keys
# This is used to create the final image with you and the celebrity
FAL_KEY=your_fal_key_here

# 🌐 Local Server Configuration
PORT=3001
