# 🔑 RunPod API Configuration
# Copy this file to .env and fill in your actual values

# Your RunPod API Key
# Get this from: https://www.runpod.io/console/user/settings
# Click "API Keys" → "Create API Key"
RUNPOD_API_KEY=your_api_key_here

# Your RunPod Endpoint ID
# Get this from: https://www.runpod.io/console/serverless
# Deploy a "ComfyUI + Flux Schnell" endpoint and copy the ID
RUNPOD_ENDPOINT_ID=your_endpoint_id_here

# Your Fal.ai API Key (for Viva la Selfie app)
# Get this from: https://fal.ai/dashboard/keys
FAL_KEY=your_fal_key_here

# Your Google GenAI API Key (for Nano Banana Pro level!)
# Get this from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_key_here
